<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>YouTube Dark — Conteúdo Sem Aparecer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;}
body{background:#050816;font-family:'Inter',sans-serif;overflow:hidden;}
.presentation{width:100vw;height:100vh;overflow:hidden;position:relative;}
.slides{display:flex;height:100vh;transition:transform .7s cubic-bezier(.22,1,.36,1);}
.slide{width:100vw;height:100vh;flex-shrink:0;position:relative;display:flex;align-items:center;justify-content:center;padding:60px 80px;background:linear-gradient(180deg,#0A0F24 0%,#070B1D 45%,#050816 100%);}
.slide::before{content:'';position:absolute;inset:0;z-index:0;pointer-events:none;background:
  radial-gradient(900px 420px at 72% 18%, rgba(255,120,180,.14) 0%, transparent 42%),
  radial-gradient(800px 380px at 35% 20%, rgba(35,110,255,.14) 0%, transparent 42%),
  linear-gradient(180deg, #0A0F24 0%, #070B1D 45%, #050816 100%);}
.slide::after{content:'';position:absolute;inset:0;z-index:0;pointer-events:none;opacity:.3;background-image:radial-gradient(rgba(255,255,255,.06) .8px, transparent .8px);background-size:24px 24px;}
.slide>*{position:relative;z-index:1;}
h1{font-weight:900;letter-spacing:-.03em;line-height:1.08;color:#F5F7FB;}
h2{font-weight:800;letter-spacing:-.025em;line-height:1.12;color:#F5F7FB;}
h3{font-weight:700;letter-spacing:-.015em;color:#F5F7FB;}
p,span,li{font-weight:400;line-height:1.6;color:#AAB3C5;}

.gt{background:linear-gradient(135deg,#2E6BFF 0%,#C86DD7 50%,#2E6BFF 100%);background-size:200% auto;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;animation:shimmer 4s linear infinite;}
@keyframes shimmer{0%{background-position:-200% center}100%{background-position:200% center}}

.gl{width:90px;height:4px;border-radius:2px;background:linear-gradient(90deg,#2E6BFF,#C86DD7);margin-bottom:22px;animation:lineG .8s ease both;transform-origin:left;}
.gl.ce{margin:0 auto 22px auto;transform-origin:center;}
@keyframes lineG{from{transform:scaleX(0)}to{transform:scaleX(1)}}

.card{background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);border-radius:22px;box-shadow:0 16px 48px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.04);padding:32px 28px;backdrop-filter:blur(8px);transition:all .4s ease;}
.card:hover{border-color:rgba(46,107,255,.2);transform:translateY(-3px);box-shadow:0 24px 60px rgba(0,0,0,.5),0 0 30px rgba(46,107,255,.08);}

.cp{background:linear-gradient(145deg,rgba(18,11,43,.95) 0%,rgba(10,15,36,.98) 55%,rgba(5,8,22,1) 100%);border:1px solid rgba(255,255,255,.08);border-radius:22px;box-shadow:0 20px 50px rgba(0,0,0,.45),0 0 40px rgba(46,107,255,.08);padding:34px 30px;backdrop-filter:blur(10px);transition:all .4s ease;}
.cp:hover{border-color:rgba(46,107,255,.25);transform:translateY(-3px) scale(1.01);box-shadow:0 28px 64px rgba(0,0,0,.55),0 0 50px rgba(46,107,255,.12);}

.badge{display:inline-flex;align-items:center;gap:10px;padding:10px 24px;border-radius:999px;margin-bottom:32px;background:rgba(46,107,255,.08);border:1px solid rgba(46,107,255,.2);font-size:14px;font-weight:600;color:#8FAEFF;letter-spacing:.05em;text-transform:uppercase;}

.tn{width:72px;height:72px;border-radius:18px;margin:0 auto 26px;display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:900;color:#fff;animation:glowP 3s ease-in-out infinite;}
.tn.n1{background:linear-gradient(145deg,#2E6BFF,#1E56D9);}
.tn.n2{background:linear-gradient(145deg,#5B3FD6,#4530B3);animation-delay:.5s;}
.tn.n3{background:linear-gradient(145deg,#C86DD7,#A854BF);animation-delay:1s;}
.tn.n4{background:linear-gradient(145deg,#2E6BFF,#C86DD7);animation-delay:1.5s;}
@keyframes glowP{0%,100%{box-shadow:0 0 18px rgba(46,107,255,.12)}50%{box-shadow:0 0 36px rgba(46,107,255,.3)}}

.ic{width:54px;height:54px;border-radius:14px;margin-bottom:18px;display:flex;align-items:center;justify-content:center;background:rgba(46,107,255,.08);}
.ic svg{width:26px;height:26px;color:#2E6BFF;}

.s5c{position:relative;overflow:hidden;}
.s5c::before{content:'';position:absolute;top:0;left:0;width:5px;height:100%;border-radius:2px 0 0 2px;}

.s5n{font-size:58px;font-weight:900;letter-spacing:-.03em;line-height:1.1;margin-bottom:10px;}

.fl{display:flex;align-items:center;justify-content:center;gap:0;flex-wrap:wrap;}
.fs{display:flex;flex-direction:column;align-items:center;text-align:center;min-width:135px;padding:0 8px;}
.fs .fi{width:76px;height:76px;border-radius:20px;background:rgba(46,107,255,.08);border:1px solid rgba(46,107,255,.18);display:flex;align-items:center;justify-content:center;margin-bottom:14px;}
.fs .fi svg{width:34px;height:34px;color:#2E6BFF;}
.fs span{font-size:15px;font-weight:600;color:#F5F7FB;}
.fa{display:flex;align-items:center;padding-bottom:30px;margin:0 6px;}
.fa svg{width:26px;height:26px;color:#7E879B;}
.fs.act .fi{background:linear-gradient(180deg,#2E6BFF,#1E56D9);border-color:transparent;box-shadow:0 10px 22px rgba(46,107,255,.28);}
.fs.act .fi svg{color:#fff;}

.bwc{border-radius:20px;padding:28px 24px;}
.bwc.cr{background:rgba(255,80,80,.05);border:1px solid rgba(255,80,80,.12);}
.bwc.cy{background:rgba(255,200,60,.05);border:1px solid rgba(255,200,60,.12);}
.bwc.cg{background:rgba(80,220,120,.05);border:1px solid rgba(80,220,120,.12);}
.bwd{width:6px;height:6px;border-radius:50%;display:inline-block;margin-right:8px;}

@keyframes fadeUp{from{opacity:0;transform:translateY(35px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeScale{from{opacity:0;transform:scale(.88)}to{opacity:1;transform:scale(1)}}
.slide.active .au{animation:fadeUp .7s ease both;}
.slide.active .as{animation:fadeScale .7s ease both;}
.d1{animation-delay:.1s !important}
.d2{animation-delay:.22s !important}
.d3{animation-delay:.34s !important}
.d4{animation-delay:.46s !important}
.d5{animation-delay:.58s !important}
.d6{animation-delay:.7s !important}
.d7{animation-delay:.82s !important}

.s1{text-align:center;max-width:1000px;margin:0 auto;}
.s1 h1{font-size:clamp(52px,7vw,82px);margin-bottom:26px;}
.s1 .tag{font-size:22px;color:#AAB3C5;max-width:650px;margin:0 auto;line-height:1.5;}

.content-wrap{max-width:1200px;width:100%;}
.content-wrap h2{font-size:clamp(34px,4.5vw,50px);margin-bottom:16px;}
.subtitle{font-size:18px;color:#AAB3C5;max-width:700px;margin-bottom:40px;}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:22px;}
.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:22px;}
.grid4{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:20px;}

.progress{position:fixed;top:0;left:0;height:3px;z-index:1000;background:linear-gradient(90deg,#2E6BFF,#C86DD7,#2E6BFF);background-size:200% auto;animation:shimmer 3s linear infinite;transition:width .6s ease;}

.fs-btn{position:fixed;top:20px;right:20px;z-index:999;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);color:#7E879B;padding:12px 18px;border-radius:12px;cursor:pointer;font-family:'Inter',sans-serif;font-size:12px;font-weight:600;display:flex;align-items:center;gap:8px;transition:all .3s ease;backdrop-filter:blur(6px);letter-spacing:.04em;text-transform:uppercase;}
.fs-btn:hover{background:rgba(255,255,255,.08);color:#F5F7FB;border-color:rgba(46,107,255,.3);}
.fs-btn svg{width:16px;height:16px;}

.sc{position:fixed;bottom:36px;left:40px;z-index:998;color:#7E879B;font-size:14px;font-weight:600;letter-spacing:.05em;background:rgba(0,0,0,.3);padding:10px 18px;border-radius:10px;backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,.05);}
.sc .cn{color:#2E6BFF;font-weight:800;}

.ind{position:fixed;bottom:36px;left:50%;transform:translateX(-50%);z-index:998;display:flex;gap:7px;background:rgba(0,0,0,.3);padding:10px 16px;border-radius:20px;backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.05);}
.ind .dot{width:10px;height:10px;border-radius:50%;background:rgba(255,255,255,.15);transition:all .4s ease;cursor:pointer;}
.ind .dot.active{background:#2E6BFF;box-shadow:0 0 14px rgba(46,107,255,.6);width:34px;border-radius:5px;}

.nav-arr{position:fixed;bottom:32px;right:40px;z-index:998;display:flex;gap:10px;}
.nav-arr button{width:52px;height:52px;border-radius:14px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);color:#AAB3C5;font-size:20px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .3s ease;backdrop-filter:blur(6px);}
.nav-arr button:hover{background:rgba(46,107,255,.2);border-color:rgba(46,107,255,.4);color:#fff;transform:scale(1.05);}

li{margin-bottom:10px;}
ul{list-style:none;}
ul li::before{content:'—';color:#2E6BFF;margin-right:10px;}
</style>
</head>
