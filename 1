<script>
const T = 10; let C = 0;
const W = document.getElementById('sw');
const CN = document.getElementById('cn');
const P = document.getElementById('prog');
const I = document.getElementById('ind');

for (let i = 0; i < T; i++) {
  const d = document.createElement('div');
  d.classList.add('dot');
  if (i === 0) d.classList.add('active');
  d.onclick = () => go(i);
  I.appendChild(d);
}

function upd() {
  I.querySelectorAll('.dot').forEach((d, i) => d.classList.toggle('active', i === C));
  CN.textContent = C + 1;
  P.style.width = ((C + 1) / T * 100) + '%';
  document.querySelectorAll('.slide').forEach((s, i) => s.classList.toggle('active', i === C));
}

function go(i) { if (i < 0 || i >= T) return; C = i; W.style.transform = `translateX(-${C * 100}vw)`; upd(); }
function next() { if (C < T - 1) go(C + 1); }
function prev() { if (C > 0) go(C - 1); }

document.addEventListener('keydown', e => {
  if (e.key === 'ArrowRight' || e.key === ' ') { e.preventDefault(); next(); }
  if (e.key === 'ArrowLeft') { e.preventDefault(); prev(); }
  if (e.key === 'f' || e.key === 'F') toggleFs();
});

let tx = 0;
document.addEventListener('touchstart', e => tx = e.changedTouches[0].screenX);
document.addEventListener('touchend', e => { const d = tx - e.changedTouches[0].screenX; if (Math.abs(d) > 50) { d > 0 ? next() : prev(); } });

function toggleFs() {
  if (!document.fullscreenElement) {
    document.documentElement.requestFullscreen().catch(() => {});
  } else {
    document.exitFullscreen();
  }
}

document.addEventListener('fullscreenchange', () => {
  const btn = document.getElementById('fsTxt');
  if (btn) btn.textContent = document.fullscreenElement ? 'Sair' : 'Tela cheia';
});

upd();
</script>

